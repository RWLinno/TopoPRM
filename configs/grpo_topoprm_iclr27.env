# Raw graph H is diagnosed before acyclic projection to G.
TOPO_DAG_RAW_DIRECTED=1
TOPO_DAG_EDGE_CHECKPOINT=${EXP_ROOT}/edge_encoder_qwen3_5_0p8b_lora_correctedseg
TOPO_DAG_EDGE_MODEL=${MODEL_ROOT}/Qwen3.5-0.8B
TOPO_DAG_EDGE_DEVICE=auto
TOPO_DAG_EDGE_BATCH_SIZE=64
TOPO_DAG_EDGE_MAX_STEPS=32
TOPO_DAG_EDGE_REQUIRED=1
TOPO_DAG_LLM_REFINE=0

# Qwen3.5's Swift template owns the opening <think> token. Reward callables
# receive only the continuation, which must contain one closing tag and a box.
TOPO_FORMAT_PROTOCOL=prefilled_think

# Robust free-form step extraction without graph tags in the policy output.
TOPO_NO_THINK_FALLBACK=1
TOPO_DAG_SENTENCE_FALLBACK=1
TOPO_DAG_SENTENCE_MIN_LEN=24
TOPO_DAG_EXTRA_STEP_MARKERS=1
TOPO_DAG_LATEX_EXPR=1
TOPO_DAG_BARRIER_STRICT=1
TOPO_DAG_BARRIER_MIN_OVERLAP=0.20
TOPO_DAG_FILTER_FORMATTING=1
TOPO_DAG_SEQ_WHEN_NO_DEP_ONLY=1
TOPO_CONT_REQUIRE_EVIDENCE=1

# Fixed main reward: no correctness-first stratification or adaptive reweighting.
TOPO_DYNAMIC_REWARD=0
TOPO_QTOPO_SELF_NORM=0
# Intentionally unset until the author approves either `balanced` or
# `structure_forward`; the independent reward refuses to instantiate otherwise.
# Generated traces have no node alignment with a reference-solution DAG.
TOPO_LAMBDA_KAPPA=0
TOPO_LENGTH_UNIT=chars
TOPO_LENGTH_LOW=2000
TOPO_LENGTH_HIGH=8000
TOPO_REWARD_LOG_EVERY=10
TOPO_VERIFY_LOG_EVERY=10

# The canonical config owns its explicit Stage-I adapter path.
AUTO_RESOLVE_SFT_ADAPTER=0
