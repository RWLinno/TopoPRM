# TopoPRM v2 — all patch flags enabled for the retrain experiment.
# Source this file or pass it to run_grpo_topoprm_v2.sh.
# See docs/method_diagnosis_2026-05-14.md for rationale.

# P0: dead-band batch rescaling when within-group topology spread < MIN_SPAN
TOPO_RESCALE_PATCH=1
TOPO_RESCALE_MIN_SPAN=0.05

# P2: truly multiplicative aggregation (outcome=0 => r_total=0)
TOPO_HIER_AGG=multiplicative

# P3: require evidence (expr/claim overlap) to count a step as continuous
TOPO_CONT_REQUIRE_EVIDENCE=1

# P4: sentence-split fallback when no explicit step markers found
TOPO_DAG_SENTENCE_FALLBACK=1
TOPO_DAG_SENTENCE_MIN_LEN=20

# P5: length reward in tokens (not chars); thresholds tuned for long-CoT
TOPO_LENGTH_UNIT=tokens
TOPO_LENGTH_LOW=512
TOPO_LENGTH_HIGH=8192

# P1: SCAE preserve outcome magnitude across strata
TOPO_SCAE_PRESERVE_OUTCOME=1
TOPO_SCAE_FLOOR_POS=0.3
TOPO_SCAE_FLOOR_NEG=0.3
