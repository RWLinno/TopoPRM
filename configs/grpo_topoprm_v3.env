# TopoPRM v3 DAG-extractor refinement profile (opt-in).
# Keeps all legacy checkpoints reproducible: only effective when sourced.

# v2 patches
TOPO_RESCALE_PATCH=1
TOPO_RESCALE_MIN_SPAN=0.05
TOPO_HIER_AGG=multiplicative
TOPO_CONT_REQUIRE_EVIDENCE=1
TOPO_DAG_SENTENCE_FALLBACK=1
TOPO_DAG_SENTENCE_MIN_LEN=24
TOPO_LENGTH_UNIT=tokens
TOPO_LENGTH_LOW=512
TOPO_LENGTH_HIGH=8192
TOPO_SCAE_PRESERVE_OUTCOME=1
TOPO_SCAE_FLOOR_POS=0.3
TOPO_SCAE_FLOOR_NEG=0.3

# Iterative DAG audit refinements (v3)
TOPO_DAG_EXTRA_STEP_MARKERS=1
TOPO_DAG_LATEX_EXPR=1
TOPO_DAG_BARRIER_STRICT=1
TOPO_DAG_BARRIER_MIN_OVERLAP=0.2
TOPO_DAG_FILTER_FORMATTING=1
TOPO_DAG_SEQ_WHEN_NO_DEP_ONLY=1

# Optional low-variance stabilizer for q_topo.
TOPO_QTOPO_SELF_NORM=1
TOPO_QTOPO_TARGET_VAR=0.05
TOPO_QTOPO_MIN_SPREAD=1e-3
